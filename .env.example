# 1. Supabase Project Credentials (Didapat dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Gemini API Key Gratisan (Didapat dari https://aistudio.google.com)
NEXT_PUBLIC_GEMINI_API_KEY=

